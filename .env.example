# Enterprise Brain configuration. Copy to .env and adjust. Never commit a real .env.
# Every variable is optional in development; see README "Configuration" for details.

# --- Application ---
# development | test | production (production enforces strong secrets and secure cookies)
ENVIRONMENT=development
APP_NAME=Enterprise Brain
PORT=8002
WORKERS=1

# --- Security (SECRET_KEY is REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
# COOKIE_SECURE defaults to true in production (serve behind HTTPS)
# COOKIE_SECURE=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
# Comma-separated browser origins allowed to call the API cross-site (empty = none)
CORS_ORIGINS=

# --- First admin (created only when the database has no users) ---
# Production requires a 12+ character password that is not a known default.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Storage ---
DATABASE_URL=sqlite:///./data/enterprise_brain.db
# DATABASE_URL=postgresql+psycopg2://eb:eb@localhost:5432/enterprise_brain
DATA_DIR=./data
# STAGING_DIR=/mnt/exports
AUTO_MIGRATE=true
MAX_UPLOAD_MB=25
# Used by docker-compose.yml for the bundled PostgreSQL
POSTGRES_PASSWORD=changeme

# --- Demo data (10 sample documents + 3 connectors) ---
DEMO_DATA=false

# --- Answers: LLM_PROVIDER = auto | none | mock | openai ---
# auto: use the OpenAI-compatible LLM when LLM_BASE_URL is set, otherwise extractive answers.
# mock: deterministic offline LLM (tests/demos). none: always extractive.
LLM_PROVIDER=auto
# Groq (free tier):         LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_CHAT_MODEL=llama-3.1-8b-instant
# OpenRouter (free models): LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (no key):    LLM_BASE_URL=http://localhost:11434/v1       LLM_CHAT_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embeddings: hashed (local, default) | openai (any OpenAI-compatible /embeddings) | st ---
EMBEDDINGS=hashed
# EMBED_BASE_URL defaults to LLM_BASE_URL, EMBED_API_KEY to LLM_API_KEY
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_MODEL=nomic-embed-text
# After changing EMBEDDINGS run: enterprise-brain reindex

# --- Background connector sync in minutes (0 = off). Enable on ONE instance only. ---
SYNC_INTERVAL_MINUTES=0

# --- Logging ---
LOG_LEVEL=INFO
# auto (json in production) | json | text
LOG_FORMAT=auto
