{
  "name": "enterprise-brain",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[dev]' && (test -f .env || cp .env.example .env)",
  "postStartCommand": "DEMO_DATA=true nohup enterprise-brain serve > /tmp/enterprise-brain.log 2>&1 &",
  "forwardPorts": [8002],
  "portsAttributes": {
    "8002": { "label": "Enterprise Brain", "onAutoForward": "openPreview" }
  }
}
