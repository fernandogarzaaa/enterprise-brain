{
  "name": "enterprise-brain",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "api",
  "workspaceFolder": "/srv/app",
  "forwardPorts": [
    "8002"
  ],
  "portsAttributes": {
    "8002": {
      "label": "enterprise-brain",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "echo 'Codespace ready: the app auto-seeds on first boot.'"
}
